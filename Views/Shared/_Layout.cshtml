<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Access Desk</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#main-content">Lewati ke konten</a>
    <header class="site-header">
        <div class="container header-inner">
            <a class="brand" asp-controller="Home" asp-action="Index">Access Desk</a>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <form asp-controller="Account" asp-action="Logout" method="post">
                    @Html.AntiForgeryToken()
                    <button class="button button-ghost" type="submit">Keluar</button>
                </form>
            }
        </div>
    </header>
    <main id="main-content" class="container page-content">
        @RenderBody()
    </main>
    <footer class="site-footer">
        <div class="container">ASP.NET Core MVC / .NET 8</div>
    </footer>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
