@model LoginViewModel
@{
    ViewData["Title"] = "Masuk";
}
<section class="auth-shell">
    <div class="auth-intro">
        <p class="eyebrow">Access Desk / Sign in</p>
        <h1>Kelola persediaan dengan jelas.</h1>
        <p>Masuk untuk melihat produk, kategori, dan perubahan stok dalam satu ruang kerja.</p>
    </div>
    <div class="auth-card">
        <h2>Masuk ke akun</h2>
        <p class="auth-card-lead">Gunakan akun yang sudah tersedia di environment ini.</p>
        @using (Html.BeginForm("Login", "Account", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(false, "", new { @class = "form-alert" })
            @Html.HiddenFor(model => model.ReturnUrl)
            <div class="form-field">
                @Html.LabelFor(model => model.Username)
                @Html.TextBoxFor(model => model.Username, new { autocomplete = "username", autofocus = "autofocus" })
                @Html.ValidationMessageFor(model => model.Username)
            </div>
            <div class="form-field">
                @Html.LabelFor(model => model.Password)
                @Html.PasswordFor(model => model.Password, new { autocomplete = "current-password" })
                @Html.ValidationMessageFor(model => model.Password)
            </div>
            <label class="checkbox-line">
                @Html.CheckBoxFor(model => model.RememberMe)
                <span>Ingat saya di perangkat ini</span>
            </label>
            <button class="button button-primary button-wide" type="submit">Masuk</button>
        }
    </div>
</section>
