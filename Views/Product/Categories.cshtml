@{
    ViewData["Title"] = "Kategori";
}

<header class="page-heading">
    <div>
        <p class="eyebrow">Katalog</p>
        <h1>Kategori produk</h1>
        <p class="page-lead">Kelompokkan produk agar pencarian dan pemantauan stok lebih mudah.</p>
    </div>
    <span class="status-note">Contoh data</span>
</header>

<section class="category-grid" aria-label="Daftar kategori">
    <article class="category-card">
        <span class="category-number">01</span>
        <h2>Minuman</h2>
        <p>Kopi, teh, dan produk minuman siap jual.</p>
        <span class="category-count">2 produk</span>
    </article>
    <article class="category-card">
        <span class="category-number">02</span>
        <h2>Bahan baku</h2>
        <p>Material utama yang digunakan dalam produksi.</p>
        <span class="category-count">1 produk</span>
    </article>
    <article class="category-card">
        <span class="category-number">03</span>
        <h2>Kemasan</h2>
        <p>Kantong, botol, dan kebutuhan pengemasan.</p>
        <span class="category-count">0 produk</span>
    </article>
</section>
